# Copy this file to .env.local and fill in your Supabase project values.
# Project Settings -> API in the Supabase dashboard.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Optional: set to "json" to force the local JSON fallback.
# When unset, the app uses Supabase if the two values above are configured.
VITE_DATA_SOURCE=json
